  "license": "MIT",
  "author": "butfool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butfool/pi-inline-skills.git"
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
