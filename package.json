{
  "name": "@butcool/pi-inline-skills",
  "version": "1.0.1",
  "description": "Invoke Pi skills anywhere in a prompt with $name or /skill:name.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "skills",
    "autocomplete"
  ],
  "homepage": "https://github.com/butfool/pi-inline-skills#readme",
